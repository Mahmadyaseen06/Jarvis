# ==============================================================
# ULTRON — Free Open-Source Local Desktop Automation Agent
# ==============================================================

# Free-Tier Cloud LLM Keys:
# 1. Groq (Free fast inference via https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_free_api_key_here

# 2. Google AI Studio (Free tier Gemini via https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here

# Local Offline LLM Configuration (100% Free, zero external API keys needed)
# Run locally using: ollama run llama3.2 (or gemma2 / mistral)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM Provider Preference: "groq", "gemini", or "ollama"
# (Ultron automatically cascades to the first available provider)
DEFAULT_LLM_PROVIDER=groq

# Desktop & Storage Paths
DESKTOP_PATH=~/Desktop
SCREENSHOTS_DIR=screenshots
LOGS_DIR=logs

# Safety Guardrails:
# When true, Ultron prompts for user confirmation before executing destructive
# file operations (e.g. deletion) or external messaging.
ULTRON_SAFE_MODE=true
